# Application Host Ports (Unique for Reelsgate-Roxx to avoid collision with Reelsgate on same VPS)
FRONTEND_PORT=8082
BACKEND_PORT=8018
DB_HOST_PORT=3308
REDIS_HOST_PORT=6381

PORT=8008
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=reelsgate_roxx_user
DB_PASSWORD=your_strong_db_password
DB_DATABASE=reelsgate_roxx_db
DB_ROOT_PASSWORD=your_strong_root_password
MYSQL_DATABASE=reelsgate_roxx_db
MYSQL_USER=reelsgate_roxx_user
MYSQL_PASSWORD=your_strong_db_password
MYSQL_ROOT_PASSWORD=your_strong_root_password
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Security & CORS
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
CORS_ORIGIN=*
JWT_SECRET=your_super_secret_jwt_key_here

# Redis Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3 / Cloudflare R2 Configuration (Production Storage)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_CLIENT_ENDPOINT=https://pub-<hash>.r2.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_key
S3_BUCKET_NAME=reelsgate-roxx-prod
S3_FORCE_PATH_STYLE=false

# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Hostinger Mail / SMTP Configuration
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_EMAIL=noreply@reelsgateroxx.com
MAIL_PASSWORD=your_hostinger_email_password
MAIL_FROM_NAME=Reelsgate Roxx
MAIL_FROM_ADDRESS=noreply@reelsgateroxx.com

# 2Factor.in SMS Gateway Configuration
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=
